# ── Claude API ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Notion ──────────────────────────────────────────────────────
NOTION_TOKEN=secret_...
NOTION_ITEMS_DB_ID=           # 執行 python3 main.py --init-notion --page-id <ID> 自動填入
NOTION_REPORTS_DB_ID=         # 同上

# ── Gmail SMTP ──────────────────────────────────────────────────
GMAIL_SENDER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # 16 字元 App Password（不含空格）
GMAIL_RECIPIENT=team@company.com

# ── Dcard（選填）────────────────────────────────────────────────
# 從 Chrome DevTools → Network → 任一 dcard api/v2 請求 → Headers → Authorization
DCARD_TOKEN=                  # Bearer xxxxxxxxxxxxxxxx...

# ── 行為設定（以下為預設值，可依需求調整）──────────────────────
DAYS_LOOKBACK=7          # 每次抓取往前追溯幾天
MAX_ITEMS_PER_SOURCE=50  # 每個來源每次最多抓取幾筆
BATCH_SIZE_CLAUDE=20     # 每批送給 Claude 幾則（控制 API 成本）
